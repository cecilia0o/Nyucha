# =========================================================
# CHARACTER POSITIONS
# =========================================================

transform left_char:
    xalign -0.20
    yalign -0.01
    zoom 1.170


transform left_char_flip:
    xalign -0.20
    yalign -0.01
    zoom 1.170
    xzoom -1


transform right_char:
    xalign 1.10
    yalign -0.01
    zoom 1.170


transform center_char:
    xalign 0.5
    yalign -0.01
    zoom 0.75


transform kebin_pos:
    xalign 1.10
    yalign -0.02
    zoom 1.140


transform cecep_pos:
    xalign 1.10
    yalign -0.0
    zoom 0.75


transform eline_small:
    xalign 1.10
    yalign -0.01
    zoom 0.735


transform kebin_center:
    xalign 0.5
    yalign -0.01
    zoom 1.140